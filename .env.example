# ═══════════════════════════════════════════════════════════
#  QUANT PLATFORM — Environment Configuration
#  Copy to .env and fill in your values before running setup.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quantuser:changeme@localhost/quantdb
DATABASE_URL_SYNC=postgresql+psycopg2://quantuser:changeme@localhost/quantdb

# ── Redis (control state + WebSocket pub/sub) ────────────────
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════
# ⚠️  ALPACA BROKERAGE — LIVE TRADING SAFETY CONTROLS
# ═══════════════════════════════════════════════════════════
#
# Get keys from: https://app.alpaca.markets/
#
# DEFAULT IS PAPER TRADING (safe, no real money).
# To enable LIVE trading you must BOTH:
#   1) Change ALPACA_BASE_URL to https://api.alpaca.markets
#   2) Set ALPACA_LIVE_CONFIRMED=true
# If either condition is missing, the platform stays in paper mode.
# ═══════════════════════════════════════════════════════════

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_LIVE_CONFIRMED=false

# ── Risk Limits (apply to BOTH paper and live) ───────────────
# Max total drawdown from peak equity before trading halts
MAX_DRAWDOWN_PCT=5.0
# Max loss for a single trading day
MAX_DAILY_LOSS_PCT=2.0
# Max size of one position as % of total equity
MAX_POSITION_SIZE_PCT=10.0
# Max simultaneous open positions
MAX_OPEN_POSITIONS=10
# Rate limit to prevent runaway algorithms
MAX_ORDERS_PER_MINUTE=10

# ── Runtime Control Flags ────────────────────────────────────
TRADING_ENABLED=true
STRATEGIES_ENABLED=true

# ── Backtesting ──────────────────────────────────────────────
BACKTEST_DEFAULT_CAPITAL=100000.0
BACKTEST_COMMISSION_PER_TRADE=0.0
BACKTEST_SLIPPAGE_BPS=2.0
